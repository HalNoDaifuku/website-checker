display:
  # 初回登録時も通知する
  # 初回通知が不要なら false に変更してください
  new: true

  # 変更検知時に通知する
  error: true

  # 変更なしの場合は通知しない
  unchanged: false

  # 差分が空になった場合も変更として扱う
  empty-diff: true

job_defaults:
  all:
    # 差分表示を unified diff にする
    diff_tool: unified

  url:
    # 一時的な接続エラーを無視しない
    # 監視失敗もDiscordへ通知したいので false
    ignore_connection_errors: false

    # HTTPキャッシュに引っ張られたくない場合は true
    ignore_cached: true

report:
  text:
    details: true
    footer: true
    line_length: 120
    minimal: false

  stdout:
    enabled: true
    color: false

  discord:
    enabled: true
    webhook_url: "__DISCORD_WEBHOOK_URL__"

    # Discord埋め込み形式
    embed: true

    # diffを色付きコードブロック風にする
    colored: true

    # Discord通知のタイトル
    subject: "{count}件のWebサイト変更: {jobs}"
