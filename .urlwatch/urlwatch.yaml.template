display:
  # 初回登録時も通知する
  # 初回通知が不要なら false に変更してください
  new: true

  # エラーも通知する
  error: true

  # 変更なしの場合は通知しない
  unchanged: false

  # diff_filter などで差分が空になっても変更扱いにする
  empty-diff: true

job_defaults:
  url:
    # HTTPキャッシュに引っ張られたくない場合は true
    ignore_cached: true

    # 一時的な接続エラーも通知したいので false
    ignore_connection_errors: false

report:
  text:
    details: true
    footer: false
    line_length: 120
    minimal: false

  stdout:
    enabled: true
    color: false

  discord:
    enabled: true
    webhook_url: "__DISCORD_WEBHOOK_URL__"

    # Discord埋め込み形式
    embed: true

    # diffを色付きコードブロック風にする
    colored: true

    # Discord通知のタイトル
    subject: "{count}件のWebサイト変更: {jobs}"
